<?xml version="1.0"?>
<odoo>
    <data>


    <!-- list -->
    <record id="view_tree_odoo_sample_module_perfil" model="ir.ui.view">
        <field name="name">Perfil</field>
        <field name="model">perfil.model</field>
        <field name="arch" type="xml">
            <list string="Perfil">
                <field name="name"/>
                <field name="data"/>
                <field name="valor"/>
                <field name="numero_inteiro"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_form_odoo_sample_module_perfil" model="ir.ui.view">
        <field name="name">Perfil</field>
        <field name="model">perfil.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record model="ir.actions.act_window" id="action_odoo_sample_module_perfil">
        <field name="name">perfil</field>
        <field name="res_model">perfil.model</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>