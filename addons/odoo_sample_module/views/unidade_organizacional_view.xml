<?xml version="1.0"?>
<odoo>
    <data>


    <!-- list -->
    <record id="view_tree_odoo_sample_module_unidade_organizacional" model="ir.ui.view">
        <field name="name">Unidade Organizacional</field>
        <field name="model">unidade.organizacional.model</field>
        <field name="arch" type="xml">
            <list string="Unidade Organizacional">
                <field name="name"/>
                <field name="codigo"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_form_odoo_sample_module_unidade_organizacional" model="ir.ui.view">
        <field name="name">Unidade Organizacional</field>
        <field name="model">unidade.organizacional.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="codigo" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record model="ir.actions.act_window" id="action_odoo_sample_module_unidade_organizacional">
        <field name="name">Unidade Organizacional</field>
        <field name="res_model">unidade.organizacional.model</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>


